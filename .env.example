# ==============================================================================
# Servex Contractor Environment Variables Template
# ==============================================================================

# 1. Google OAuth 2.0 Client ID (Web Application Client ID from Google Cloud Console)
# Redirect URI authorized in Google Cloud: https://auth.expo.io/@nikhil9209/servex-contractor
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Live SMS Gateway Provider (Optional - choose Fast2SMS for India or Twilio for Global)
#
# Option A: Fast2SMS (Recommended for India +91 - instant free credits, no DLT required for testing)
# Sign up at https://www.fast2sms.com and grab your API Key from Dev API tab
EXPO_PUBLIC_FAST2SMS_API_KEY=

# Option B: Twilio (For International / Global cellular SMS delivery)
# Account SID, Auth Token and active Phone Number from Twilio Console
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=
EXPO_PUBLIC_TWILIO_PHONE_NUMBER=

# 3. Supabase Cloud Backend (Optional - offline-first persistence is active by default)
# Project URL & Anon Public API Key from Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
